    {
      "title": "Solar PV Power",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "green", "value": 1000 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": "InfluxDB",
          "query": "from(bucket: \"power\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"sunny_boy\" and r.metric == \"ac_watts\")\n  |> last()\n  |> map(fn: (r) => ({r with _value: float(v: r._value)}))"
        }
      ]
    },
    {
      "title": "Solar Hot Water",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "manifold" },
            "properties": [{ "id": "displayName", "value": "Manifold" }]
          },
          {
            "matcher": { "id": "byName", "options": "tank_upper" },
            "properties": [{ "id": "displayName", "value": "Tank Upper" }]
          }
        ]
      },
      "targets": [
        {
          "datasource": "InfluxDB",
          "query": "from(bucket: \"power\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"solar_hot_water\")\n  |> last()\n  |> map(fn: (r) => ({r with _value: float(v: r._value)}))\n  |> group(columns: [\"sensor\"])"
        }
      ]
    },
    {
      "title": "System Status",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "true": { "text": "ON", "color": "green" }, "false": { "text": "OFF", "color": "text" } } }
          ]
        }
      },
      "targets": [
        {
          "datasource": "InfluxDB",
          "query": "from(bucket: \"power\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"sunny_island\" and (r.metric == \"engaged\" or r.metric == \"request\" or r.metric == \"fan\"))\n  |> last()\n  |> keep(columns: [\"metric\", \"category\", \"_value\"])"
        }
      ]
    },
    {
      "title": "Battery SOC (24h)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "gradientMode": "scheme"
          },
          "color": {
            "mode": "continuous-GrYlRd"
          }
        }
      },
      "options": {
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "datasource": "InfluxDB",
          "query": "from(bucket: \"power\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"sunny_island\" and r.metric == \"charge\" and r.category == \"battery\")\n  |> map(fn: (r) => ({r with _value: float(v: r._value)}))\n  |> aggregateWindow(every: 1m, fn: mean, createEmpty: false)"
        }
      ]
    },
    {

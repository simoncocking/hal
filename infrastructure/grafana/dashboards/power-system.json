  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Battery SOC",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "yellow", "value": 40 },
              { "color": "green", "value": 60 }
            ]
          },
          "min": 0,
          "max": 100,
          "unit": "percent"
        }
      },
      "targets": [
        {
          "datasource": "InfluxDB",
          "query": "from(bucket: \"power\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"sunny_island\" and r.metric == \"charge\" and r.category == \"battery\")\n  |> last()\n  |> map(fn: (r) => ({r with _value: float(v: r._value)}))"
        }
      ]
    },
    {
      "title": "Charge / Discharge Power",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 2 },
              { "color": "red", "value": 4 }
            ]
          },
          "unit": "kwatt"
        }
      },
      "targets": [
        {
          "datasource": "InfluxDB",
          "query": "from(bucket: \"power\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"sunny_island\" and r.metric == \"power\" and r.category == \"flow\")\n  |> last()\n  |> map(fn: (r) => ({r with _value: float(v: r._value)}))"
        }
      ]
    },
    {
      "title": "Generator Output",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "orange", "value": 0.1 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": "InfluxDB",
          "query": "from(bucket: \"power\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"sunny_island\" and r.metric == \"output\" and r.category == \"genset\")\n  |> last()\n  |> map(fn: (r) => ({r with _value: float(v: r._value)}))"
        }

          "query": "from(bucket: \"power\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"sunny_boy\" and r.metric == \"ac_watts\")\n  |> map(fn: (r) => ({r with _value: float(v: r._value)}))\n  |> aggregateWindow(every: 5m, fn: mean, createEmpty: false)"

      "targets": [
        {
          "datasource": "InfluxDB",
          "query": "load = from(bucket: \"power\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sunny_island\" and r.metric == \"load\")\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> map(fn: (r) => ({_time: r._time, _field: \"load\", _value: float(v: r._value)}))\n  |> group(columns: [\"_field\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n\npv_hist = from(bucket: \"power\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sunny_boy\" and r.metric == \"ac_watts\" and r.source == \"migration\")\n  |> keep(columns: [\"_time\", \"_value\"])\n\npv_live = from(bucket: \"power\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sunny_boy\" and r.metric == \"ac_watts\" and exists r.site)\n  |> toFloat()\n  |> keep(columns: [\"_time\", \"_value\"])\n\npv = union(tables: [pv_hist, pv_live])\n  |> group()\n  |> map(fn: (r) => ({_time: r._time, _field: \"pv\", _value: r._value / 1000.0}))\n  |> group(columns: [\"_field\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n\nunion(tables: [load, pv])\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({_time: r._time, _value: (if exists r.load then r.load else 0.0) + (if exists r.pv then r.pv else 0.0)}))",

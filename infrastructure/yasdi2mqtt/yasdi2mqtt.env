# yasdi2mqtt environment configuration for Pi 4
# Deployed to /etc/yasdi2mqtt.env

# YASDI configuration
YASDI_CONFIG=/etc/yasdi.ini
YASDI_DRIVER_ID=COM1
YASDI_MAX_DEVICE_COUNT=1
YASDI_UPDATE_INTERVAL=30

# MQTT broker (Pi 1)
MQTT_TOPIC_PREFIX=solar/sunny_island
MQTT_SERVER=10.0.0.3
MQTT_PORT=1883
MQTT_QOS_LEVEL=1

# Uncomment if your broker requires authentication
# MQTT_USER=
# MQTT_PASSWORD=

# Uncomment to enable TLS
# MQTT_SSL=true
